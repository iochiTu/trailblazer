{
  "name": "traiblazer",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepare": "git config core.hooksPath .githooks || true",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @traiblazer/db generate",
    "db:migrate": "pnpm --filter @traiblazer/db migrate",
    "db:seed": "pnpm --filter @traiblazer/api seed",
    "evals": "pnpm --filter @traiblazer/evals eval",
    "evals:retrieval": "pnpm --filter @traiblazer/evals eval:retrieval",
    "embeddings:backfill": "pnpm --filter @traiblazer/worker embeddings:backfill",
    "a11y": "pnpm --filter @traiblazer/e2e a11y"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "turbo": "2.11.10",
    "typescript": "~6.0.3"
  }
}
