<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. Xcode uses "development" for debug builds; App Store and
	     TestFlight builds are signed with "production" automatically by the distribution profile. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Urgent requests are time-sensitive: they show through Focus modes. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
