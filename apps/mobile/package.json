{
  "name": "@traiblazer/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-www": "node scripts/prepare-www.mjs",
    "sync": "node scripts/prepare-www.mjs && cap sync",
    "ios": "node scripts/prepare-www.mjs && cap sync ios && cap open ios",
    "android": "node scripts/prepare-www.mjs && cap sync android && cap open android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3"
  }
}
