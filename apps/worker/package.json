{
  "name": "@traiblazer/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start": "node --env-file-if-exists=../../.env dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@traiblazer/core": "workspace:*",
    "@traiblazer/db": "workspace:*",
    "@traiblazer/llm": "workspace:*",
    "nodemailer": "8.0.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "8.0.2",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  }
}
