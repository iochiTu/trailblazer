{
  "name": "@traiblazer/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "superadmin": "tsx --env-file-if-exists=../../.env src/superadmin-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@traiblazer/addons": "workspace:*",
    "@traiblazer/appearance": "workspace:*",
    "@traiblazer/core": "workspace:*",
    "@traiblazer/db": "workspace:*",
    "@traiblazer/i18n": "workspace:*",
    "@traiblazer/industry-packs": "workspace:*",
    "@traiblazer/llm": "workspace:*",
    "@traiblazer/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  }
}
