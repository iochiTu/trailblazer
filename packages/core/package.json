{
  "name": "@traiblazer/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@traiblazer/addons": "workspace:*",
    "@traiblazer/db": "workspace:*",
    "@traiblazer/i18n": "workspace:*",
    "@traiblazer/industry-packs": "workspace:*",
    "@traiblazer/integrations": "workspace:*",
    "@traiblazer/llm": "workspace:*",
    "@traiblazer/shared": "workspace:*",
    "@traiblazer/telephony": "workspace:*",
    "cheerio": "1.2.0",
    "drizzle-orm": "0.45.4",
    "mammoth": "1.13.0",
    "robots-parser": "3.0.1",
    "undici": "7.30.1",
    "unpdf": "2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  }
}
