# Copy to .env and adjust. Local defaults match docker-compose.yml.

# Owner role: used only for migrations and seeding.
DATABASE_URL=postgres://traiblazer:traiblazer@localhost:5433/traiblazer
# Application role (row-level security applies): used by the API at runtime.
DATABASE_APP_URL=postgres://traiblazer_app:traiblazer_app@localhost:5433/traiblazer

REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
# Origin of the admin portal (used for CORS-free proxying and cookie settings).
ADMIN_ORIGIN=http://localhost:3000
# Set to "true" behind HTTPS so session cookies are marked Secure.
COOKIE_SECURE=false
# Proxies allowed to set X-Forwarded-For (client IP for rate limits): "true" only if the API can't be
# reached except through your proxy, otherwise a comma-separated list of IPs/CIDRs or the names
# loopback, linklocal, uniquelocal.
TRUST_PROXY=loopback,uniquelocal
# Sign-in attempts allowed per account per 15 minutes, from any IP.
LOGIN_ATTEMPTS_PER_ACCOUNT=20

# Public origin of the API: chat page links (/c/<key>), widget.js, same-origin checks.
PUBLIC_URL=http://localhost:4000

# Admin portal: where Next.js proxies /api/* requests.
API_INTERNAL_URL=http://localhost:4000
# The admin's content security policy allows chat previews and photos from PUBLIC_URL; set it in the
# admin's environment too when it differs from API_INTERNAL_URL (always in production).

# ---- AI providers ---------------------------------------------------------------------------
# Without any key, chat runs on the offline test provider (no real AI, no cost).
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# Any OpenAI-compatible endpoint (OpenAI, Azure OpenAI v1, Groq, Ollama, vLLM, …):
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=
# Ordered routes "provider:model" (later ones are fallbacks). Defaults with an Anthropic key:
# LLM_CHAT_ROUTES=anthropic:claude-opus-5-5
# LLM_AUX_ROUTES=anthropic:claude-haiku-5-5
# Every route names its provider, e.g. LLM_CHAT_ROUTES=openrouter:deepseek/deepseek-v4.1-flash-1017
# Owner-side jobs that run rarely per business, such as the setup assistant (default: the chat routes).
# LLM_AGENT_ROUTES=anthropic:claude-opus-5-5
# Most text of a business's pages the setup assistant gives the model, in characters (default 48000).
# Lower it for local models with a short context window.
# SETUP_MAX_INPUT_CHARS=48000
# Models on OpenRouter / the OpenAI-compatible endpoint that can call tools ("*" for all). Claude
# models always can. Without this the assistant still answers, but can't use tools: it can't save
# visitors' requests, check service areas or search again (the API logs a warning at startup).
# OPENROUTER_TOOL_MODELS=*
# OPENAI_COMPATIBLE_TOOL_MODELS=*
# How much reasoning models on OpenRouter / the OpenAI-compatible endpoint think before answering:
# none, minimal, low, medium, high, xhigh or max. Not sent unless set (endpoints reject it for models
# that don't reason). On a local model, "none" or "low" makes replies much faster.
# OPENROUTER_REASONING_EFFORT=low
# OPENAI_COMPATIBLE_REASONING_EFFORT=none

# ---- Embeddings: search by meaning (optional; keyword + fuzzy search work without) -------------
# See docs/EMBEDDINGS.md. After changing the model or size: pnpm embeddings:backfill
# Measured best (pnpm evals:retrieval): voyage-4-lite, via Voyage or via OpenRouter (which then uses
# OPENROUTER_API_KEY when EMBEDDINGS_API_KEY is empty).
# EMBEDDINGS_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDINGS_MODEL=mongodb/voyage-4-lite
# EMBEDDINGS_INPUT_TYPE=true
# EMBEDDINGS_MAX_DISTANCE=0.75
# Direct from Voyage instead:
# EMBEDDINGS_BASE_URL=https://api.voyageai.com/v1
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=voyage-4-lite
# EMBEDDINGS_DIMENSIONS=512
# EMBEDDINGS_PRICE_PER_MTOK=0.02
# How long an answer waits for the question's vector once the keyword search is ready (ms)
# Or a model run inside the API and worker (nothing leaves the server; no cost per call). The model
# (about 130 MB) is downloaded on first use; each process holds it in memory (0.6–1 GB).
# EMBEDDINGS_PROVIDER=local
# EMBEDDINGS_MODEL=Xenova/multilingual-e5-small
# EMBEDDINGS_MAX_DISTANCE=0.23
# EMBEDDINGS_CACHE_DIR=/var/lib/traiblazer/models   # where the model is kept (default: inside node_modules)
# EMBEDDINGS_LOCAL_OFFLINE=true                     # never download; the model must be in the folder
# EMBEDDINGS_QUERY_WAIT_MS=250

# ---- Phone and SMS (optional; docs/PHONE_AND_SMS.md) ------------------------------------------
# Without these, the telephony webhooks don't exist and no text is sent. Set them for the API and
# the worker. In Twilio, point the number's "A message comes in" webhook at
# <PUBLIC_URL>/v1/telephony/twilio/sms and "A call comes in" at <PUBLIC_URL>/v1/telephony/twilio/voice.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Local development without a Twilio account: the Phone tab and the webhooks work, and texts are
# "sent" to memory (webhooks under /v1/telephony/fake/, header "x-fake-signature: valid"). Ignored
# when NODE_ENV is production.
# TELEPHONY_PROVIDER=fake
# The address Twilio calls, when it isn't PUBLIC_URL (a tunnel in development). Must be https for
# delivery reports.
# TELEPHONY_WEBHOOK_URL=
# What one message part costs, in millionths of a dollar (usage records; default 8300 = 0.83 cents).
# SMS_SEGMENT_COST_MICROS=8300

# ---- Email (add-on notifications) -------------------------------------------------------------
# Without SMTP_URL, the worker writes emails to its log instead of sending them.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Traiblazer <notifications@example.com>
