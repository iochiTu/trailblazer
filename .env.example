# Copy to .env and adjust. Local defaults match docker-compose.yml.

# Owner role: used only for migrations and seeding.
DATABASE_URL=postgres://traiblazer:traiblazer@localhost:5433/traiblazer
# Application role (row-level security applies): used by the API at runtime.
DATABASE_APP_URL=postgres://traiblazer_app:traiblazer_app@localhost:5433/traiblazer

REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
# Origin of the admin portal (used for CORS-free proxying and cookie settings).
ADMIN_ORIGIN=http://localhost:3000
# Set to "true" behind HTTPS so session cookies are marked Secure.
COOKIE_SECURE=false
# Proxies allowed to set X-Forwarded-For (client IP for rate limits): "true" only if the API can't be
# reached except through your proxy, otherwise a comma-separated list of IPs/CIDRs or the names
# loopback, linklocal, uniquelocal.
TRUST_PROXY=loopback,uniquelocal
# Sign-in attempts allowed per account per 15 minutes, from any IP.
LOGIN_ATTEMPTS_PER_ACCOUNT=20

# Public origin of the API: chat page links (/c/<key>), widget.js, same-origin checks.
PUBLIC_URL=http://localhost:4000

# Admin portal: where Next.js proxies /api/* requests.
API_INTERNAL_URL=http://localhost:4000
# The admin's content security policy allows chat previews and photos from PUBLIC_URL; set it in the
# admin's environment too when it differs from API_INTERNAL_URL (always in production).

# ---- AI providers ---------------------------------------------------------------------------
# Without any key, chat runs on the offline test provider (no real AI, no cost).
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# Any OpenAI-compatible endpoint (OpenAI, Azure OpenAI v1, Groq, Ollama, vLLM, …):
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=
# Ordered routes "provider:model" (later ones are fallbacks). Defaults with an Anthropic key:
# LLM_CHAT_ROUTES=anthropic:claude-opus-5-5
# LLM_AUX_ROUTES=anthropic:claude-haiku-5-5

# ---- Embeddings (optional; keyword + fuzzy search work without) --------------------------------
# EMBEDDINGS_BASE_URL=https://api.voyageai.com/v1
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=
# EMBEDDINGS_INPUT_TYPE=true
